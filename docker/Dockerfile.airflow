# docker/Dockerfile.airflow - Apache Airflow ML Orchestration Image

FROM apache/airflow:2.9.3-python3.12

USER root

# Install system dependencies (build-essential, curl, OpenMP libgomp for XGBoost/LightGBM)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

USER airflow

ENV PYTHONPATH=/opt/airflow \
    AIRFLOW__CORE__LOAD_EXAMPLES=False \
    AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# Install project ML dependencies with exact pinned versions compatible with Airflow 2.9
RUN pip install --no-cache-dir \
    xgboost==3.4.1 \
    lightgbm==4.7.0 \
    optuna==4.9.0 \
    "mlflow==2.19.0" \
    shap==0.52.0 \
    evidently==0.7.21 \
    skops==0.14.0 \
    redis==5.0.7 \
    pyyaml==6.0.1 \
    psycopg2-binary==2.9.9
