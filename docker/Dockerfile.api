# docker/Dockerfile.api - FastAPI Serving Layer & Interactive Dashboard

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies (build-essential, curl, OpenMP libgomp for tree models)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code and configurations
COPY api/ /app/api/
COPY configs/ /app/configs/
COPY database/ /app/database/
COPY explainability/ /app/explainability/
COPY feature_store/ /app/feature_store/
COPY ml/ /app/ml/
COPY models/ /app/models/
COPY pipelines/ /app/pipelines/
COPY shared/ /app/shared/
COPY main.py /app/main.py

# Ensure runtime directories exist
RUN mkdir -p /app/logs /app/dataset/reports /app/dataset/processed

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "main.py"]
